# ── PMC-CCOREA-SHIPPING-1B · SHADOW-mode shipping quote (2026-09-13) ──
# When true the auto-listing pipeline calls the main service's
# /api/internal/shipping/listing-preview (server-to-server, bearer-token) and records
# the recomputed shipping-aware listing price for owner review. The eBay
# payload itself STILL uses the legacy value in this phase.
# When false the request is not made at all — legacy path only.
AUTO_LISTING_SHIPPING_SHADOW_ENABLED=false

# Main service base URL (this project is the client of that service).
MAIN_SERVICE_URL=http://localhost:3001

# Server-to-server bearer token — must match SHIPPING_QUOTE_INTERNAL_TOKEN
# on the main service. 16 chars minimum. Admin browser cookies are NEVER
# used here. Git 에 실 값 커밋 금지.
SHIPPING_QUOTE_INTERNAL_TOKEN=

# ── Shipping-aware eBay listing price (main /api/internal/shipping/quote raw) ──
# 가격 = CSV 판매가(또는 수동 판매가) + 국제배송비 USD (ceil(KRW / 환율 × 100) / 100)
# 기본 false: false이면 USD CSV(toybox) 상품은 eBay 등록 차단 (CSV 판매가 단독 등록 없음), 레거시 상품은 기존 계산. MAIN_SERVICE_URL / 토큰은 위 값을 공유
AUTO_LISTING_SHIPPING_PRICING_ENABLED=false
# 배송비 KRW → USD 환율 (KRW per USD). 없거나 0 이하이면 견적·배송비 반영 등록 차단
AUTO_LISTING_SHIPPING_EXCHANGE_RATE=
# 구매자 배송비는 CSV 가져오기 화면에서 upload별로 선택한 eBay Shipping Policy 금액을 사용 (등록가에서 빼거나 더하지 않음)
# main service shipping_services 활성 코드 (2026-09-14 production 확인: eGS v3 = EGS_STD_US, KPL v4 = KPL_SF_US)
AUTO_LISTING_EGS_SERVICE_CODE=
AUTO_LISTING_KPL_US_SERVICE_CODE=
