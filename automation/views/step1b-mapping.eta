<div class="page-header">
  <h1 class="page-title">컬럼 매핑 확인</h1>
  <span class="badge"><%= it.filename %> &middot; <%= it.totalRows %>개 행</span>
</div>

<div class="card">
  <div class="section-header">
    <h2><i class="ti ti-columns-3"></i> CSV 컬럼 매핑</h2>
    <span class="text-muted">각 컬럼이 어떤 필드인지 확인하세요</span>
  </div>

  <div style="overflow-x: auto;">
    <table id="mapping-table">
      <thead>
        <tr>
          <th style="width:40px">#</th>
          <th>CSV 헤더</th>
          <th style="width:200px">매핑 대상</th>
          <th>샘플 데이터</th>
        </tr>
      </thead>
      <tbody>
        <% it.headerRow.forEach((header, colIdx) => { %>
        <tr>
          <td class="text-muted"><%= colIdx %></td>
          <td><strong><%= header || '(컬럼 ' + (colIdx + 1) + ')' %></strong></td>
          <td>
            <select class="mapping-select" data-col="<%= colIdx %>"
                    style="width:100%;padding:6px 8px;border-radius:var(--radius);border:1px solid var(--border);font-size:var(--text-sm);">
              <option value="">(무시)</option>
              <optgroup label="기본">
                <option value="name">상품명</option>
                <option value="nameKo">상품명 (한글, 참고)</option>
                <option value="sourceProductCode">상품코드</option>
                <option value="url">상품 URL (원본 링크)</option>
                <option value="image">이미지 URL (메인)</option>
                <option value="originalImageUrl">원본 이미지 URL</option>
                <option value="category">카테고리</option>
                <option value="brand">브랜드</option>
                <option value="description">설명</option>
              </optgroup>
              <optgroup label="가격">
                <option value="salePriceUsd">판매가 (USD)</option>
                <option value="price">가격 (원)</option>
                <option value="purchaseCostKrw">매입원가 (원)</option>
                <option value="retailPriceKrw">정가 (원)</option>
                <option value="originalPrice">정가</option>
                <option value="discountRate">할인율</option>
                <option value="marginKrw">마진 (원, 참고)</option>
                <option value="marginRate">마진율 (참고)</option>
              </optgroup>
              <optgroup label="무게 · 치수">
                <option value="chargeableWeightG">적용무게 (g)</option>
                <option value="actualWeightG">실측무게 (g)</option>
                <option value="volumetricWeightG">부피무게 (g)</option>
                <option value="lengthCm">가로 (cm)</option>
                <option value="widthCm">세로 (cm)</option>
                <option value="heightCm">높이 (cm)</option>
                <option value="weight">무게</option>
              </optgroup>
              <optgroup label="참고">
                <option value="sourcePage">페이지</option>
                <option value="unitsPerBox">입수량 (박스)</option>
                <option value="rating">평점</option>
                <option value="reviewCount">리뷰수</option>
              </optgroup>
            </select>
          </td>
          <td style="max-width:340px;">
            <% it.sampleRows.forEach((row) => {
              var cellVal = row[colIdx] || '';
              var display = (cellVal || '—').substring(0, 70) + (cellVal.length > 70 ? '...' : '');
            %>
              <div class="truncate text-muted" style="font-size:var(--text-xs);margin-bottom:2px;"
                   title="<%= cellVal %>">
                <%= display %>
              </div>
            <% }) %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 경고 메시지 -->
  <div id="mapping-warning" class="hidden mt-16" style="color:var(--yellow);background:rgba(202,138,4,0.08);padding:10px 16px;border-radius:var(--radius);font-size:var(--text-sm);">
    <i class="ti ti-alert-triangle"></i> <span id="warning-text"></span>
  </div>
  <div id="duplicate-warning" class="hidden mt-8" style="color:var(--red);background:rgba(220,38,38,0.08);padding:10px 16px;border-radius:var(--radius);font-size:var(--text-sm);">
    <i class="ti ti-alert-circle"></i> <span id="duplicate-text"></span>
  </div>

  <div class="flex justify-between align-center mt-24">
    <a href="/upload-csv" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> 뒤로</a>
    <button id="confirm-btn" class="btn btn-primary btn-lg" onclick="confirmMapping()">
      <i class="ti ti-check"></i> 매핑 확인 (<%= it.totalRows %>개)
    </button>
  </div>
</div>

<script>
var fieldLabels = {
  name: '상품명', price: '가격(원)', url: '상품URL', image: '이미지',
  originalPrice: '정가', discountRate: '할인율', category: '카테고리',
  brand: '브랜드', weight: '무게', description: '설명',
  rating: '평점', reviewCount: '리뷰수',
  nameKo: '상품명(한글)', sourceProductCode: '상품코드', originalImageUrl: '원본 이미지',
  salePriceUsd: '판매가(USD)', purchaseCostKrw: '매입원가(원)', retailPriceKrw: '정가(원)',
  marginKrw: '마진(원)', marginRate: '마진율', chargeableWeightG: '적용무게(g)',
  actualWeightG: '실측무게(g)', volumetricWeightG: '부피무게(g)',
  lengthCm: '가로(cm)', widthCm: '세로(cm)', heightCm: '높이(cm)',
  sourcePage: '페이지', unitsPerBox: '입수량(박스)'
};

// autoMapping으로 드롭다운 초기값 설정 (서버는 키워드 매핑을 즉시 반환,
// AI 매핑은 백그라운드 수행 후 DB에 갱신됨 → 아래 폴링이 따라잡음)
var autoMapping = <%~ JSON.stringify(it.autoMapping) %>;
var initialMappingSig = JSON.stringify(autoMapping);

function applyMapping(mapping) {
  document.querySelectorAll('.mapping-select').forEach(function(sel) { sel.value = ''; });
  for (var field in mapping) {
    var sel = document.querySelector('select[data-col="' + mapping[field] + '"]');
    if (sel) sel.value = field;
  }
  validateMapping();
}

document.addEventListener('DOMContentLoaded', function() {
  applyMapping(autoMapping);
  // 고정 헤더(toybox) CSV: 서버가 결정적 매핑을 저장했고 AI 매핑은 실행되지 않음 → 폴링 불필요
  if (<%~ it.fixedHeaderMapping ? 'true' : 'false' %>) {
    var fixedEl = document.createElement('div');
    fixedEl.style.cssText = 'margin-top:8px;font-size:var(--text-xs);color:var(--text-muted);';
    fixedEl.innerHTML = '<i class="ti ti-lock"></i> 고정 헤더 CSV — 자동 매핑 적용됨 (필요하면 드롭다운에서 변경)';
    var header = document.querySelector('.section-header');
    if (header) header.appendChild(fixedEl);
  } else {
    startAiMappingPoll();
  }
});

// AI 매핑이 백그라운드에서 도착하면 자동 반영. 사용자가 이미 매핑을 손댔으면 건드리지 않음.
function startAiMappingPoll() {
  var uploadId = '<%= it.uploadId %>';
  var pollCount = 0;
  var maxPolls = 8; // 2초 × 8 = 16초까지 대기
  var userTouched = false;
  document.querySelectorAll('.mapping-select').forEach(function(sel) {
    sel.addEventListener('change', function() { userTouched = true; }, { once: true });
  });

  var statusEl = document.createElement('div');
  statusEl.style.cssText = 'margin-top:8px;font-size:var(--text-xs);color:var(--text-muted);';
  statusEl.innerHTML = '<i class="ti ti-sparkles"></i> AI가 컬럼 매핑을 분석 중…';
  var sectionHeader = document.querySelector('.section-header');
  if (sectionHeader) sectionHeader.appendChild(statusEl);

  function tick() {
    pollCount++;
    fetch('/api/upload/' + uploadId + '/status')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var newMap = data.columnMapping || {};
        var newSig = JSON.stringify(newMap);
        if (newSig !== initialMappingSig && Object.keys(newMap).length > 0) {
          if (!userTouched) {
            applyMapping(newMap);
            statusEl.innerHTML = '<i class="ti ti-check" style="color:var(--green);"></i> AI 분석 결과 적용됨';
            setTimeout(function() { statusEl.remove(); }, 4000);
          } else {
            statusEl.innerHTML = '<i class="ti ti-info-circle"></i> AI가 더 정확한 매핑을 제안했습니다 (직접 설정한 항목은 유지)';
          }
          return;
        }
        if (pollCount < maxPolls) setTimeout(tick, 2000);
        else { statusEl.innerHTML = '<i class="ti ti-keyboard"></i> 키워드 매핑 사용 (AI 분석 시간 초과)'; setTimeout(function() { statusEl.remove(); }, 4000); }
      })
      .catch(function() { if (pollCount < maxPolls) setTimeout(tick, 2000); });
  }
  setTimeout(tick, 2000);
}

// 드롭다운 변경 시 유효성 검사
document.querySelectorAll('.mapping-select').forEach(function(sel) {
  sel.addEventListener('change', validateMapping);
});

function validateMapping() {
  var selects = document.querySelectorAll('.mapping-select');
  var usedFields = {};
  var duplicates = [];

  selects.forEach(function(sel) {
    var field = sel.value;
    if (!field) return;
    if (usedFields[field]) {
      duplicates.push(field);
    }
    usedFields[field] = true;
  });

  // 중복 체크
  var dupEl = document.getElementById('duplicate-warning');
  if (duplicates.length > 0) {
    document.getElementById('duplicate-text').textContent =
      '같은 필드가 여러 컬럼에 선택됨: ' + duplicates.map(function(f) { return fieldLabels[f] || f; }).join(', ');
    dupEl.classList.remove('hidden');
  } else {
    dupEl.classList.add('hidden');
  }

  // 필수 필드 체크
  var warnEl = document.getElementById('mapping-warning');
  var warnText = document.getElementById('warning-text');
  var hasPriceOrUrl = usedFields.url || usedFields.price || usedFields.salePriceUsd;
  var conflict = '';
  if (usedFields.price && usedFields.salePriceUsd) conflict = '"가격(원)"과 "판매가(USD)"는 동시에 매핑할 수 없습니다.';
  else if (usedFields.weight && usedFields.chargeableWeightG) conflict = '"무게"와 "적용무게(g)"는 동시에 매핑할 수 없습니다.';

  if (!usedFields.name) {
    warnText.textContent = '"상품명" 매핑이 필요합니다.';
    warnEl.classList.remove('hidden');
  } else if (!hasPriceOrUrl) {
    warnText.textContent = '"상품URL", "가격(원)", "판매가(USD)" 중 하나는 매핑이 필요합니다.';
    warnEl.classList.remove('hidden');
  } else if (conflict) {
    warnText.textContent = conflict;
    warnEl.classList.remove('hidden');
  } else {
    warnEl.classList.add('hidden');
  }

  // 버튼 활성화
  var btn = document.getElementById('confirm-btn');
  btn.disabled = !usedFields.name || !hasPriceOrUrl || !!conflict || duplicates.length > 0;
}

async function confirmMapping() {
  var btn = document.getElementById('confirm-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> 처리 중...';

  var mapping = {};
  document.querySelectorAll('.mapping-select').forEach(function(sel) {
    if (sel.value) mapping[sel.value] = parseInt(sel.dataset.col);
  });

  try {
    var res = await fetch('/api/upload/confirm-mapping', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ uploadId: '<%= it.uploadId %>', mapping: mapping }),
    });
    var data = await res.json();
    if (!res.ok) throw new Error(data.error || '서버 오류');

    window.location.href = '/import?uploadId=' + data.uploadId;
  } catch (e) {
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-check"></i> 매핑 확인 (<%= it.totalRows %>개)';
    if (typeof showToast === 'function') showToast('매핑 실패: ' + e.message, 'error');
  }
}
</script>
