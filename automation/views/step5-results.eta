<div class="page-header">
  <h1 class="page-title">업로드 결과</h1>
  <div class="flex gap-8 align-center">
    <span class="text-muted"><%= it.job.platforms.join(' + ').toUpperCase() %></span>
    <% if (it.job.dryRun) { %>
      <span class="badge badge-draft"><i class="ti ti-test-pipe"></i> 테스트</span>
    <% } else { %>
      <span class="badge badge-success"><i class="ti ti-check"></i> 실제</span>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="summary">
    <div class="summary-item summary-total">
      <div class="number"><%= it.job.total %></div>
      <div class="label">전체</div>
    </div>
    <div class="summary-item summary-success">
      <div class="number"><%= it.job.completed %></div>
      <div class="label">성공</div>
    </div>
    <div class="summary-item summary-fail">
      <div class="number"><%= it.job.failed %></div>
      <div class="label">실패</div>
    </div>
    <div class="summary-item summary-total">
      <div class="number"><%= it.job.results.filter(r => r.status === 'SKIPPED_EBAY_REQUIRED').length %></div>
      <div class="label">미실행</div>
    </div>
  </div>
  <div id="product-result-summary" data-testid="product-result-summary" class="mt-16"></div>

  <div class="flex gap-16 flex-wrap text-muted" style="margin-bottom: var(--space-2);">
    <div>
      <i class="ti ti-clock"></i>
      <strong>시작:</strong>
      <%= new Date(it.job.createdAt).toLocaleString('ko-KR') %>
    </div>
    <% if (it.job.finishedAt) { %>
    <div>
      <i class="ti ti-clock-check"></i>
      <strong>완료:</strong>
      <%= new Date(it.job.finishedAt).toLocaleString('ko-KR') %>
    </div>
    <div>
      <i class="ti ti-hourglass"></i>
      <strong>소요:</strong>
      <%
        const elapsed = Math.round((new Date(it.job.finishedAt).getTime() - new Date(it.job.createdAt).getTime()) / 1000);
        const mins = Math.floor(elapsed / 60);
        const secs = elapsed % 60;
      %>
      <% if (mins > 0) { %><%= mins %>분 <% } %><%= secs %>초
    </div>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="section-header">
    <h2><i class="ti ti-list-details"></i> 상세 결과</h2>
  </div>

  <div style="overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>상품명</th>
          <th>플랫폼</th>
          <th>상태</th>
          <th>플랫폼 ID</th>
          <th>링크</th>
        </tr>
      </thead>
      <tbody>
        <% it.job.results.forEach((r, i) => { %>
        <tr>
          <td class="text-muted"><%= i + 1 %></td>
          <td class="truncate"><%= r.title %></td>
          <td><span class="badge badge-<%= r.platform || 'ebay' %>"><%= (r.platform || '').toUpperCase() %></span></td>
          <td>
            <% const rStatus = r.status || (r.success ? 'SUCCESS' : 'FAILED'); %>
            <% if (rStatus === 'SUCCESS') { %>
              <span class="badge badge-success" data-result-status="SUCCESS"><i class="ti ti-check"></i> <%= r.code === 'ADOPTED_EXISTING' ? '성공 (기존 상품 연결)' : '성공' %></span>
            <% } else if (rStatus === 'ALREADY_LISTED') { %>
              <span class="badge badge-success" data-result-status="ALREADY_LISTED"><i class="ti ti-check"></i> 기존 등록 확인</span>
            <% } else if (rStatus === 'SKIPPED_EBAY_REQUIRED') { %>
              <span class="badge badge-pending" data-result-status="SKIPPED_EBAY_REQUIRED"><i class="ti ti-player-pause"></i> 미실행 · eBay 등록 필요</span>
              <% if (r.platform === 'shopify' && r.productId) { %>
              <button type="button" class="btn btn-secondary btn-xs retry-shopify-btn" data-product-id="<%= r.productId %>" title="eBay가 active로 등록된 뒤 새 job에서 Shopify 단계만 실행합니다">Shopify만 다시 실행</button>
              <% } %>
            <% } else { %>
              <span class="badge badge-error" data-result-status="FAILED"><i class="ti ti-x"></i> 실패<%= r.code ? ' · ' + r.code : '' %></span>
            <% } %>
          </td>
          <td class="font-mono"><%= r.platformItemId || '-' %></td>
          <td>
            <% if (r.listingUrl) { %>
              <a href="<%= r.listingUrl %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
                <i class="ti ti-external-link"></i> 보기
              </a>
            <% } else if (r.error) { %>
              <span class="text-muted" title="<%= r.error %>"><%= r.error.substring(0, 50) %></span>
            <% } else { %>
              -
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex gap-8 mt-16">
  <a href="/" class="btn btn-primary btn-lg"><i class="ti ti-home"></i> 홈으로</a>
  <a href="/" class="btn btn-secondary"><i class="ti ti-shopping-cart"></i> 상품 관리</a>
  <a href="/history" class="btn btn-secondary"><i class="ti ti-history"></i> 히스토리</a>
</div>

<script type="module">
import { summarizeProductResults } from '/js/listing-plan.js';
const results = <%~ JSON.stringify(it.job.results).replace(/</g, '\\u003c') %>;
const box = document.getElementById('product-result-summary');
const list = document.createElement('ul');
list.className = 'product-result-list';
summarizeProductResults(results).forEach(item => {
  const li = document.createElement('li');
  const title = document.createElement('strong');
  title.textContent = item.title + ': ';
  li.append(title, item.text);
  list.appendChild(li);
});
if (list.children.length) box.appendChild(list);

//   미실행 Shopify: 새 job에서 Shopify 단계만 실행 (eBay는 호출하지 않음 — DB에 active eBay Item ID가 없으면 다시 미실행)
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('.retry-shopify-btn');
  if (!btn || btn.disabled) return;
  btn.disabled = true;
  try {
    const res = await fetch('/api/listings/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productIds: [Number(btn.dataset.productId)], platforms: ['shopify'], csvPlatforms: ['shopify'], dryRun: false }),
    });
    const data = await res.json();
    if (data.jobId) window.location.href = '/upload?jobId=' + data.jobId;
    else { alert(data.error || '실행 실패'); btn.disabled = false; }
  } catch (err) {
    alert('요청 실패: ' + err.message);
    btn.disabled = false;
  }
});
</script>
