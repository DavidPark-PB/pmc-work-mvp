<%
  const shipping = it.shipping || { enabled: false, exchangeRateConfigured: false, quoteConfigured: false };
  const showShipping = !!it.showShipping;
  //   신규 CSV 구매자 배송비는 upload에서 선택한 eBay 배송정책 snapshot 기준
  const policy = it.shippingPolicy || null;
  const policyBuyerLabel = policy ? (policy.buyerShippingUsd === 0 ? '무료' : '$' + Number(policy.buyerShippingUsd).toFixed(2)) : '';
  //   신규 USD CSV는 배송정책 선택 전 DB 가져오기 불가 (레거시 KRW CSV 제외)
  const policyRequired = showShipping;
  const importBlockedByPolicy = policyRequired && !policy;
  //   분류는 겹치지 않음: 정상 + 자동복구 + 대체 가능 + 확인 필요 + 미계산 = 전체 (서버 summarizeQuoteRows와 동일)
  const quoteSummary = { ok: 0, recovered: 0, alternative: 0, review: 0, pending: 0, total: 0, unfinished: 0 };
  it.rows.forEach(r => {
    if (!r.shippingProvider) return;
    quoteSummary.total++;
    if (r.quoteCategory === 'OK') quoteSummary.ok++;
    else if (r.quoteCategory === 'RECOVERED') quoteSummary.recovered++;
    else if (r.quoteCategory === 'ALTERNATIVE') quoteSummary.alternative++;
    else if (r.quoteCategory === 'REVIEW') quoteSummary.review++;
    else quoteSummary.pending++;
    if (r.quoteUnfinished) quoteSummary.unfinished++;
  });
  const quotedCount = quoteSummary.ok + quoteSummary.recovered + quoteSummary.alternative + quoteSummary.review;
  const emphasizeUnfinished = quotedCount > 0 && quoteSummary.unfinished > 0;
  const fmt = (v) => Number(v).toLocaleString('en-US');
%>
<div class="page-header">
  <h1 class="page-title">상품 검수 · 선택</h1>
  <span class="badge badge-unregistered"><i class="ti ti-database-off"></i> 미등록</span>
</div>

<div class="card">
  <div class="section-header import-toolbar">
    <h2><i class="ti ti-table"></i> 발견된 상품</h2>
    <div class="import-toolbar-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="select-all-btn"><i class="ti ti-checks"></i> 전체 선택</button>
      <button type="button" class="btn btn-secondary btn-sm" id="clear-all-btn"><i class="ti ti-square-off"></i> 전체 해제</button>
      <span class="text-muted" id="selection-summary" data-testid="selection-count">선택 <%= it.defaultSelectedCount %> / 전체 <%= it.rowCount %>개</span>
    </div>
  </div>

  <% if (showShipping) { %>
  <div class="import-policy-bar" id="policy-bar" data-testid="policy-bar">
    <label class="import-shipping-label" for="policy-select">eBay 배송정책</label>
    <input type="search" id="policy-search" class="import-select import-policy-search" placeholder="정책명 검색" aria-label="정책명 검색" autocomplete="off">
    <select id="policy-select" class="import-select import-policy-select" aria-label="eBay 배송정책" autocomplete="off">
      <option value=""<%~ policy ? '' : ' selected' %>>배송정책을 선택하세요</option>
      <% if (policy) { %><option value="<%= policy.policyId %>" selected><%= policy.buyerShippingUsd === 0 ? '추천 · ' + policy.policyName + ' — 무료배송' : policy.policyName + ' — ' + policyBuyerLabel %></option><% } %>
    </select>
    <span class="import-policy-summary" id="policy-summary" data-testid="policy-summary">
      <% if (policy) { %>선택 배송정책: <strong><%= policy.policyName %></strong> · 구매자 배송비: <strong><%= policyBuyerLabel %></strong>
      <% } else { %><span class="import-policy-missing">배송정책을 선택해주세요. 상품 검수와 배송비 계산은 가능하지만 eBay 등록은 할 수 없습니다.</span><% } %>
    </span>
    <span class="text-muted import-policy-status" id="policy-status">배송정책 목록 불러오는 중…</span>
    <span class="import-policy-save-status" id="policy-save-status" data-testid="policy-save-status" hidden></span>
    <span class="import-policy-error" id="policy-save-error" data-testid="policy-save-error" hidden><span id="policy-save-error-message"></span> <small class="text-muted" id="policy-save-error-detail"></small></span>
    <span class="import-policy-error" id="policy-error" data-testid="policy-error" hidden>eBay 배송정책을 불러오지 못했습니다. <button type="button" class="btn btn-secondary btn-xs" id="policy-reload-btn">다시 불러오기</button></span>
  </div>
  <div class="import-shipping-bar" id="shipping-bar">
    <label class="import-shipping-label" for="bulk-provider">선택 상품 배송사</label>
    <select id="bulk-provider" class="import-select">
      <option value="KPL" selected>KPL</option>
      <option value="eGS">eGS</option>
    </select>
    <button type="button" class="btn btn-secondary btn-sm" id="bulk-provider-btn"><i class="ti ti-truck"></i> 적용</button>
    <button type="button" class="btn <%= emphasizeUnfinished ? 'btn-secondary' : 'btn-primary' %> btn-sm" id="quote-btn"<%~ shipping.quoteConfigured ? '' : ' disabled' %>><i class="ti ti-calculator"></i> 선택 상품 국제배송비 계산</button>
    <span class="text-muted import-shipping-meta">eBay US 기준 · KPL은 미국 서비스만 사용 · 선택한 배송정책의 구매자 배송비는 별도 청구 (등록가에서 빼거나 더하지 않음)</span>
    <span class="import-egs-warning" id="egs-warning"><i class="ti ti-alert-triangle"></i> eGS는 브랜드 상품에 사용하지 않습니다.</span>
  </div>
  <% if (!shipping.enabled) { %>
  <div class="import-notice import-notice-info" data-testid="release-guard-notice">
    <i class="ti ti-lock"></i> <strong>배송비 계산 준비 중</strong> — 현재는 상품 검수와 가져오기만 가능합니다. 배송비 반영 전에는 eBay 등록이 차단됩니다. 아래 배송비·등록가는 미리보기입니다.
  </div>
  <% } %>
  <div class="import-quote-progress" id="quote-progress" data-testid="quote-progress" hidden>
    <span class="spinner" id="quote-progress-spinner"></span> <strong id="quote-progress-main">배송비 계산 중 0 / 0</strong>
    <span class="text-muted" id="quote-progress-detail">정상 0 · 자동복구 0 · 재시도 0 · 대체 확인 0 · 실패 0</span>
  </div>
  <div class="import-quote-summary" id="quote-summary" data-testid="quote-summary"<%~ quotedCount > 0 ? '' : ' hidden' %>>
    <span class="import-quote-summary-text" id="quote-summary-text">정상 <%= fmt(quoteSummary.ok) %>개 · 자동복구 <%= fmt(quoteSummary.recovered) %>개 · 대체 가능 <%= fmt(quoteSummary.alternative) %>개 · 확인 필요 <%= fmt(quoteSummary.review) %>개 · 미계산 <%= fmt(quoteSummary.pending) %>개 · 전체 <%= fmt(quoteSummary.total) %>개</span>
    <button type="button" class="btn <%= quoteSummary.unfinished > 0 ? 'btn-primary' : 'btn-secondary' %> btn-sm" id="unfinished-btn" data-testid="unfinished-btn"<%~ quoteSummary.unfinished > 0 && shipping.quoteConfigured ? '' : ' disabled' %>><i class="ti ti-refresh"></i> <span id="unfinished-btn-label"><%= quoteSummary.unfinished > 0 ? '미완료 배송비 자동 계산 (' + fmt(quoteSummary.unfinished) + '개)' : '모든 배송비 계산 완료' %></span></button>
    <button type="button" class="btn btn-secondary btn-xs" id="apply-all-alt-btn"><i class="ti ti-arrows-exchange"></i> 대체 가능 전체 적용</button>
    <button type="button" class="btn btn-secondary btn-xs" id="filter-review-btn"><i class="ti ti-filter"></i> 확인 필요만 보기</button>
    <button type="button" class="btn btn-secondary btn-xs" id="filter-all-btn"><i class="ti ti-list"></i> 전체 보기</button>
  </div>
  <% if (!shipping.quoteConfigured || !shipping.exchangeRateConfigured) { %>
  <div class="import-notice import-notice-error">
    <i class="ti ti-alert-circle"></i> 배송 견적 설정이 없습니다 (<%= !shipping.quoteConfigured ? 'main service 연결' : '' %><%= !shipping.quoteConfigured && !shipping.exchangeRateConfigured ? ', ' : '' %><%= !shipping.exchangeRateConfigured ? '배송비 환율' : '' %>). 견적이 차단되며 배송비 반영 등록도 차단됩니다.
  </div>
  <% } %>
  <% } %>

  <% if (it.errorRowCount > 0) { %>
  <div class="import-notice import-notice-error">
    <i class="ti ti-alert-circle"></i> 데이터 오류 <strong><%= it.errorRowCount %></strong>개 행은 기본 선택에서 제외되었습니다. 확인 후 필요하면 직접 선택하세요.
  </div>
  <% } %>

  <div style="overflow-x: auto;">
    <table id="import-table">
      <thead>
        <tr>
          <th style="width:36px">선택</th>
          <th>이미지</th>
          <th>상품코드</th>
          <th>상품명</th>
          <th class="text-right"><%= showShipping ? 'CSV 판매가(USD)' : it.priceHeader %></th>
          <th class="text-right">적용무게</th>
          <% if (showShipping) { %>
          <th>배송사</th>
          <th class="text-right">예상 국제배송비</th>
          <th class="text-right">eBay 등록 상품가격</th>
          <th class="text-right">정책 배송비 · 구매자 총 결제</th>
          <% } %>
          <th>원본 링크</th>
          <th>상태</th>
        </tr>
      </thead>
      <tbody>
        <% it.rows.forEach((row) => { %>
        <tr class="import-row<%= row.errorCount > 0 ? ' import-row-error' : '' %>" data-index="<%= row.index %>" data-quote-category="<%= row.quoteCategory %>" data-quote-unfinished="<%= row.quoteUnfinished ? 'true' : 'false' %>" data-listing-usd="<%= row.listingPriceUsd ?? '' %>">
          <td>
            <input type="checkbox" class="import-row-check" data-index="<%= row.index %>" aria-label="상품 선택 <%= row.index + 1 %>"<%~ row.defaultSelected ? ' checked' : '' %><%~ row.duplicateSku ? ' disabled data-duplicate-sku="true"' : '' %>>
          </td>
          <td>
            <% if (row.image) { %>
              <img src="<%= row.image %>" class="thumb import-thumb" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="thumb thumb-placeholder" style="display:none"><i class="ti ti-photo-off"></i></div>
            <% } else { %>
              <div class="thumb thumb-placeholder" style="display:flex"><i class="ti ti-photo-off"></i></div>
            <% } %>
          </td>
          <td class="tabular-nums nowrap"><%= row.code || '—' %></td>
          <td class="import-name"><span class="truncate" title="<%= row.name %>"><%= row.name %></span></td>
          <td class="text-right tabular-nums nowrap"><%= row.priceLabel %></td>
          <td class="text-right tabular-nums nowrap"><%= row.weightLabel %></td>
          <% if (showShipping) { %>
          <td class="nowrap">
            <% if (row.shippingProvider) { %>
            <select class="import-select row-provider" data-index="<%= row.index %>" aria-label="배송사 <%= row.index + 1 %>">
              <option value="KPL"<%~ row.shippingProvider === 'KPL' ? ' selected' : '' %>>KPL</option>
              <option value="eGS"<%~ row.shippingProvider === 'eGS' ? ' selected' : '' %>>eGS</option>
            </select>
            <% } else { %>—<% } %>
          </td>
          <td class="text-right tabular-nums nowrap cell-shipping" data-quote-status="<%= row.quoteStatus %>" title="<%= row.quoteTitle %>"><%= row.shippingLabel %></td>
          <td class="text-right tabular-nums nowrap cell-listing"><strong><%= row.listingPriceLabel %></strong></td>
          <td class="text-right tabular-nums nowrap text-muted"><span class="cell-policy-shipping"><%= row.shippingProvider ? (row.policyShippingLabel || '정책 미선택') : '—' %></span><div class="import-quote-msg cell-buyer-total"><%= row.buyerTotalLabel ? '구매자 총 결제 ' + row.buyerTotalLabel : '' %></div></td>
          <% } %>
          <td class="nowrap">
            <% if (row.url) { %>
              <a href="<%= row.url %>" target="_blank" rel="noopener"><i class="ti ti-external-link"></i> 링크</a>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td class="nowrap">
            <% if (row.duplicateSku) { %>
              <span class="badge badge-error" data-testid="duplicate-sku" title="<%= row.issues.map(i => i.message).join(', ') %>"><i class="ti ti-copy-off"></i> SKU 중복</span>
            <% } %>
            <% if (row.errorCount > 0) { %>
              <span class="badge badge-error" title="<%= row.issues.map(i => i.message).join(', ') %>"><i class="ti ti-alert-circle"></i> 오류 <%= row.errorCount %></span>
            <% } else if (row.warningCount > 0) { %>
              <span class="badge badge-pending" title="<%= row.issues.map(i => i.message).join(', ') %>"><i class="ti ti-alert-triangle"></i> 경고 <%= row.warningCount %></span>
            <% } else { %>
              <span class="badge badge-success"><i class="ti ti-check"></i> 정상</span>
            <% } %>
            <% if (showShipping) { %>
              <div class="import-quote-msg cell-quote-msg<%= row.quoteStatus === 'BLOCKED' || row.quoteStatus === 'WEIGHT_INVALID' ? ' is-blocked' : '' %>" title="<%= row.quoteTitle %>" data-testid="quote-detail">
                <% if (row.weightRecoveryLabel) { %><div class="quote-line quote-recovery"><%= row.weightRecoveryLabel %></div><% } %>
                <% if (row.reasonLabel) { %>
                <div class="quote-line">원인: <%= row.reasonLabel %></div>
                <% } else if (row.quoteMessage) { %>
                <div class="quote-line"><%= row.quoteMessage %></div>
                <% } %>
                <% if (row.retryNote) { %><div class="quote-line">처리: <%= row.retryNote %></div><% } %>
                <% if (row.alternative) { %>
                <div class="quote-line quote-alt">대체: <%= row.alternative.label %> · 등록가 <%= row.alternative.listingPriceLabel %>
                  <button type="button" class="btn btn-secondary btn-xs apply-alt-btn" data-index="<%= row.index %>">대체 적용</button>
                  <% if (row.alternative.warning) { %><div class="quote-alt-warn"><%= row.alternative.warning %></div><% } %>
                </div>
                <% } %>
                <% if (row.alternativeFailureLabel) { %><div class="quote-line">대체: <%= row.alternativeFailureLabel %></div><% } %>
              </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (showShipping && !shipping.enabled) { %>
  <div class="import-notice import-notice-info mt-24 import-release-guard">
    <i class="ti ti-lock"></i> <strong>배송비 계산 준비 중</strong><br>현재는 상품 검수와 가져오기만 가능합니다.<br>배송비 반영 전에는 eBay 등록이 차단됩니다.
  </div>
  <% } %>
  <% if (policyRequired) { %>
  <div class="import-notice import-notice-error mt-24" id="policy-import-notice" data-testid="policy-import-notice"<%~ importBlockedByPolicy ? '' : ' hidden' %>>
    <i class="ti ti-lock"></i> eBay 배송정책을 선택하면 상품을 가져올 수 있습니다.
  </div>
  <% } %>
  <div class="flex justify-between align-center mt-24">
    <a href="/upload-csv" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> 뒤로</a>
    <button id="import-btn" class="btn btn-primary btn-lg"<%~ it.defaultSelectedCount === 0 || importBlockedByPolicy ? ' disabled' : '' %>>
      <i class="ti ti-database-plus"></i> 선택 상품 DB에 등록하기 (<span id="import-count"><%= it.defaultSelectedCount %></span>개)
    </button>
  </div>
</div>

<div id="import-result" class="card hidden">
  <div class="section-header">
    <h2><i class="ti ti-circle-check" style="color: var(--green);"></i> 등록 완료</h2>
  </div>
  <div id="result-content"></div>
  <div class="mt-16">
    <a id="next-link" href="/" class="btn btn-success btn-lg">
      <i class="ti ti-arrow-right"></i> 다음: 상품 관리
    </a>
  </div>
</div>

<style>
.import-toolbar { flex-wrap: wrap; gap: 8px; }
.import-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.import-notice { padding: 10px 16px; border-radius: var(--radius); font-size: var(--text-sm); margin-bottom: 12px; }
.import-notice-error { color: var(--red); background: rgba(220,38,38,0.08); }
.import-notice-info { color: var(--text); background: rgba(37,99,235,0.07); }
.import-name { max-width: 360px; }
.import-row-error { background: rgba(220,38,38,0.04); }
.thumb-placeholder { align-items: center; justify-content: center; }
.thumb-placeholder i { font-size: 14px; color: var(--text-muted); }
.import-shipping-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius); }
.import-shipping-label { font-size: var(--text-sm); font-weight: 600; }
.import-select { padding: 4px 8px; border-radius: var(--radius); border: 1px solid var(--border); font-size: var(--text-sm); }
.import-shipping-meta { font-size: var(--text-xs); }
.import-egs-warning { font-size: var(--text-xs); color: var(--yellow-text, #a16207); }
.import-quote-msg { font-size: var(--text-xs); color: var(--text-muted); margin-top: 2px; max-width: 220px; white-space: normal; }
.import-quote-msg.is-blocked { color: var(--red); }
.import-quote-msg .quote-line { line-height: 1.35; }
.import-quote-msg .quote-recovery { color: var(--yellow-text, #a16207); }
.import-quote-msg .quote-alt { color: var(--text); }
.import-quote-msg .quote-alt-warn { color: var(--yellow-text, #a16207); }
.import-quote-msg .apply-alt-btn { margin-left: 4px; padding: 0 6px; }
.import-policy-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius); }
.import-policy-select { max-width: 460px; }
.import-policy-search { width: 180px; }
.import-policy-summary { font-size: var(--text-sm); }
.import-policy-missing { color: var(--yellow-text, #a16207); }
.import-policy-error { color: var(--red); font-size: var(--text-sm); }
.import-policy-save-status { font-size: var(--text-sm); font-weight: 600; }
.import-quote-progress .spinner[hidden] { display: none; }
.import-quote-summary, .import-quote-progress { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius); font-size: var(--text-sm); }
.import-quote-summary-text { font-weight: 600; }
</style>

<script type="module">
import { createSelection, createProviderState, buildImportPayload, buildQuoteRequest, formatSelectionSummary, formatQuoteSummary, formatQuoteProgress, formatQuoteCompletion, unfinishedButtonState, providerOverrides, createSingleFlight, formatBuyerShipping, policyOptionLabel, buyerTotalLabel, groupShippingPolicies, importButtonState, createPolicySelection, POLICY_PLACEHOLDER_LABEL, POLICY_SAVING_LABEL } from '/js/import-selection.js';

const uploadId = <%~ JSON.stringify(it.uploadId).replace(/</g, '\\u003c') %>;
const showShipping = <%~ showShipping ? 'true' : 'false' %>;
const checkboxes = Array.from(document.querySelectorAll('.import-row-check'));
const indexOf = (el) => Number(el.dataset.index);
//   CSV 안 SKU 중복 행은 선택 대상에서 제외 (전체 선택에도 포함하지 않음)
const selection = createSelection(
  checkboxes.filter(cb => !cb.dataset.duplicateSku).map(indexOf),
  checkboxes.filter(cb => cb.checked).map(indexOf),
);
const providerSelects = Array.from(document.querySelectorAll('.row-provider'));
const providers = createProviderState(providerSelects.map(sel => ({ index: indexOf(sel), provider: sel.value })));
//   서버에 저장된 배송사 — 화면에서만 바꾼 행은 미완료 계산 시 providerOverrides로 전달
const savedProviders = new Map(providerSelects.map(sel => [indexOf(sel), sel.value]));
const rowOf = (index) => document.querySelector('tr.import-row[data-index="' + index + '"]');

const importBtn = document.getElementById('import-btn');

function refreshImportButton() {
  //   선택 완료 여부는 화면 select 값이 아니라 서버가 반환한 persisted snapshot(policySelection.policy)으로만 판단
  const state = importButtonState({
    selectedCount: selection.count(),
    policyRequired,
    hasPolicy: !!(policySelection ? policySelection.policySelected : currentPolicy),
    saving: !!(policySelection && policySelection.saving),
  });
  importBtn.disabled = state.disabled;
  const notice = document.getElementById('policy-import-notice');
  if (notice) notice.hidden = !(policyRequired && !currentPolicy);
}

function render() {
  checkboxes.forEach(cb => { cb.checked = selection.isSelected(indexOf(cb)); });
  document.getElementById('selection-summary').textContent = formatSelectionSummary(selection);
  document.getElementById('import-count').textContent = selection.count().toLocaleString('en-US');
  refreshImportButton();
}

function markStale(index) {
  const tr = rowOf(index);
  if (!tr) return;
  const shippingCell = tr.querySelector('.cell-shipping');
  if (shippingCell && shippingCell.dataset.quoteStatus !== 'WEIGHT_INVALID') {
    shippingCell.textContent = '미계산';
    shippingCell.dataset.quoteStatus = 'NONE';
    shippingCell.title = '';
    tr.dataset.quoteCategory = 'NONE';
    if (tr.dataset.quoteUnfinished !== 'true' && typeof onRowBecameUnfinished === 'function') onRowBecameUnfinished();
    tr.dataset.quoteUnfinished = 'true';
    tr.querySelector('.cell-listing').innerHTML = '<strong>—</strong>';
    tr.querySelector('.cell-buyer-total').textContent = '';
    tr.dataset.listingUsd = '';
    const msg = tr.querySelector('.cell-quote-msg');
    msg.replaceChildren(line('배송사 변경 — 배송비 다시 계산 필요'));
    msg.title = '';
    msg.classList.remove('is-blocked');
  }
}

function line(text, className) {
  const div = document.createElement('div');
  div.className = 'quote-line' + (className ? ' ' + className : '');
  div.textContent = text;
  return div;
}

function applyQuoteRow(r) {
  const tr = rowOf(r.index);
  if (!tr) return;
  tr.dataset.quoteCategory = r.quoteCategory;
  tr.dataset.quoteUnfinished = r.quoteUnfinished ? 'true' : 'false';
  const shippingCell = tr.querySelector('.cell-shipping');
  shippingCell.textContent = r.shippingLabel;
  shippingCell.dataset.quoteStatus = r.quoteStatus;
  shippingCell.title = r.quoteTitle || '';
  const listing = document.createElement('strong');
  listing.textContent = r.listingPriceLabel;
  tr.querySelector('.cell-listing').replaceChildren(listing);
  tr.dataset.listingUsd = r.listingPriceUsd ?? '';
  const total = buyerTotalLabel(tr.dataset.listingUsd, currentPolicy);
  tr.querySelector('.cell-buyer-total').textContent = total ? '구매자 총 결제 ' + total : '';

  const msg = tr.querySelector('.cell-quote-msg');
  const lines = [];
  if (r.weightRecoveryLabel) lines.push(line(r.weightRecoveryLabel, 'quote-recovery'));
  if (r.reasonLabel) lines.push(line('원인: ' + r.reasonLabel));
  else if (r.quoteMessage) lines.push(line(r.quoteMessage));
  if (r.retryNote) lines.push(line('처리: ' + r.retryNote));
  if (r.alternative) {
    const alt = line('대체: ' + r.alternative.label + ' · 등록가 ' + r.alternative.listingPriceLabel + ' ', 'quote-alt');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-secondary btn-xs apply-alt-btn';
    btn.dataset.index = String(r.index);
    btn.textContent = '대체 적용';
    btn.disabled = quoteRun.isRunning();
    alt.appendChild(btn);
    if (r.alternative.warning) {
      const warn = document.createElement('div');
      warn.className = 'quote-alt-warn';
      warn.textContent = r.alternative.warning;
      alt.appendChild(warn);
    }
    lines.push(alt);
  }
  if (r.alternativeFailureLabel) lines.push(line('대체: ' + r.alternativeFailureLabel));
  msg.replaceChildren(...lines);
  msg.title = r.quoteTitle || '';
  msg.classList.toggle('is-blocked', r.quoteStatus === 'BLOCKED' || r.quoteStatus === 'WEIGHT_INVALID');

  if (r.shippingProvider) {
    savedProviders.set(r.index, r.shippingProvider);
    if (providers.get(r.index) !== r.shippingProvider) {
      providers.set(r.index, r.shippingProvider);
      const sel = tr.querySelector('.row-provider');
      if (sel) sel.value = r.shippingProvider;
    }
  }
}

const quoteRun = createSingleFlight();
let onRowBecameUnfinished = null;
//   upload에 저장된 선택 배송정책 (새로고침 후에도 유지)
let currentPolicy = <%~ JSON.stringify(policy).replace(/</g, '\\u003c') %>;
let policySelection = null;
const policyRequired = <%~ policyRequired ? 'true' : 'false' %>;
let hasImportedRows = <%~ it.hasImportedRows ? 'true' : 'false' %>;

document.getElementById('import-table').addEventListener('change', (e) => {
  const cb = e.target.closest('.import-row-check');
  if (cb) {
    selection.set(indexOf(cb), cb.checked);
    render();
    return;
  }
  const sel = e.target.closest('.row-provider');
  if (sel && providers.set(indexOf(sel), sel.value)) markStale(indexOf(sel));
});
document.getElementById('select-all-btn').addEventListener('click', () => { selection.selectAll(); render(); });
document.getElementById('clear-all-btn').addEventListener('click', () => { selection.clearAll(); render(); });

if (showShipping) {
  document.getElementById('bulk-provider-btn').addEventListener('click', () => {
    const provider = document.getElementById('bulk-provider').value;
    providers.setMany(selection.selectedIndices(), provider).forEach(index => {
      const sel = rowOf(index)?.querySelector('.row-provider');
      if (sel) sel.value = provider;
      markStale(index);
    });
  });

  const quoteBtn = document.getElementById('quote-btn');
  const unfinishedBtn = document.getElementById('unfinished-btn');
  const summaryBox = document.getElementById('quote-summary');
  const progressBox = document.getElementById('quote-progress');
  const quoteConfigured = <%~ shipping.quoteConfigured ? 'true' : 'false' %>;
  let unfinishedCount = <%~ String(quoteSummary.unfinished) %>;
  const busyButtons = () => [quoteBtn, unfinishedBtn, importBtn, document.getElementById('policy-select'), document.getElementById('bulk-provider-btn'), document.getElementById('apply-all-alt-btn'), ...document.querySelectorAll('.apply-alt-btn')];
  let busyNow = false;
  const renderUnfinishedButton = () => {
    const state = unfinishedButtonState(unfinishedCount);
    document.getElementById('unfinished-btn-label').textContent = state.label;
    unfinishedBtn.disabled = state.disabled || !quoteConfigured || busyNow;
    //   미완료가 남아 있으면 "미완료 배송비 자동 계산"을 우선 강조
    unfinishedBtn.classList.toggle('btn-primary', !state.disabled);
    unfinishedBtn.classList.toggle('btn-secondary', state.disabled);
    quoteBtn.classList.toggle('btn-primary', state.disabled);
    quoteBtn.classList.toggle('btn-secondary', !state.disabled);
  };
  const setBusy = (busy) => {
    busyNow = busy;
    busyButtons().forEach(b => { if (b) b.disabled = busy; });
    if (!busy) {
      refreshImportButton();
      quoteBtn.disabled = !quoteConfigured;
      document.querySelectorAll('.apply-alt-btn').forEach(b => { b.disabled = false; });
      document.getElementById('bulk-provider-btn').disabled = false;
      document.getElementById('apply-all-alt-btn').disabled = false;
      document.getElementById('policy-select').disabled = false;
      renderUnfinishedButton();
    }
  };
  const toast = (m, type) => { if (typeof showToast === 'function') showToast(m, type); };
  const updateSummary = (summary) => {
    if (!summary) return;
    document.getElementById('quote-summary-text').textContent = formatQuoteSummary(summary);
    summaryBox.hidden = (summary.ok + summary.recovered + summary.alternative + summary.review) === 0;
    if (typeof summary.unfinished === 'number') unfinishedCount = summary.unfinished;
    renderUnfinishedButton();
  };
  const showProgress = (text, spinning) => {
    document.getElementById('quote-progress-main').textContent = text.main;
    document.getElementById('quote-progress-detail').textContent = text.detail;
    document.getElementById('quote-progress-spinner').hidden = !spinning;
  };
  const sleep = (ms) => new Promise(r => setTimeout(r, ms));
  onRowBecameUnfinished = () => { unfinishedCount++; renderUnfinishedButton(); };

  /** payload: { selections } (선택 상품) 또는 { mode: 'unfinished', providerOverrides } (미완료 전체, 서버 판정) */
  async function runQuote(payload, mode) {
    if (mode !== 'unfinished' && payload.selections.length === 0) { toast('배송비를 계산할 상품을 선택하세요.', 'error'); return; }
    const started = quoteRun.run(async () => {
      setBusy(true);
      progressBox.hidden = false;
      showProgress(formatQuoteProgress({}, { mode }), true);
      let finished = false;
      try {
        const res = await fetch('/api/upload/shipping-quotes/jobs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uploadId, ...payload }),
        });
        const start = await res.json();
        if (!res.ok) throw new Error(start.error || '서버 오류 (HTTP ' + res.status + ')');
        if (start.jobId === null) {
          updateSummary(start.summary);
          showProgress(formatQuoteCompletion(start.summary), false);
          finished = true;
          toast('모든 배송비 계산 완료', 'success');
          return;
        }
        if (start.alreadyRunning) toast('이미 진행 중인 배송비 계산의 진행상태를 표시합니다.', 'info');
        let job = start;
        while (job.status === 'running') {
          showProgress(formatQuoteProgress(job.progress, { mode }), true);
          await sleep(700);
          const poll = await fetch('/api/upload/shipping-quotes/jobs/' + encodeURIComponent(start.jobId));
          job = await poll.json();
          if (!poll.ok) throw new Error(job.error || '서버 오류 (HTTP ' + poll.status + ')');
        }
        if (job.status === 'error' || !job.result) throw new Error(job.error || '배송비 계산 실패');
        job.result.rows.forEach(applyQuoteRow);
        updateSummary(job.result.summary);
        showProgress(formatQuoteCompletion(job.result.summary), false);
        finished = true;
        const s = job.result.summary;
        toast('배송비 계산 완료: ' + formatQuoteSummary(s), s.unfinished === 0 ? 'success' : 'error');
      } catch (e) {
        toast('배송비 계산 실패: ' + e.message, 'error');
      } finally {
        if (!finished) progressBox.hidden = true;
        setBusy(false);
      }
    });
    if (started === null) toast('배송비 계산이 이미 진행 중입니다.', 'error');
  }

  async function applyAlternatives(payload) {
    const started = quoteRun.run(async () => {
      setBusy(true);
      try {
        const res = await fetch('/api/upload/shipping-alternatives/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uploadId, ...payload }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '서버 오류 (HTTP ' + res.status + ')');
        data.rows.forEach(applyQuoteRow);
        updateSummary(data.summary);
        toast('대체 배송사 적용: ' + data.applied.length + '개' + (data.skipped.length ? ' (제외 ' + data.skipped.length + '개)' : ''), data.applied.length ? 'success' : 'error');
      } catch (e) {
        toast('대체 적용 실패: ' + e.message, 'error');
      } finally {
        setBusy(false);
      }
    });
    if (started === null) toast('다른 작업이 진행 중입니다.', 'error');
  }

  quoteBtn.addEventListener('click', () => runQuote({ selections: buildQuoteRequest(uploadId, selection, providers).selections }, 'selected'));
  unfinishedBtn.addEventListener('click', () => runQuote({ mode: 'unfinished', providerOverrides: providerOverrides(providers, savedProviders) }, 'unfinished'));
  document.getElementById('apply-all-alt-btn').addEventListener('click', () => applyAlternatives({ all: true }));
  document.getElementById('import-table').addEventListener('click', (e) => {
    const btn = e.target.closest('.apply-alt-btn');
    if (btn) applyAlternatives({ indices: [Number(btn.dataset.index)] });
  });
  // ── eBay 배송정책 선택 (upload 단위) ──
  const policySelect = document.getElementById('policy-select');
  policySelection = createPolicySelection({ uploadId, initialPolicy: currentPolicy, fetchImpl: (url, init) => fetch(url, init) });
  const policySaveStatus = document.getElementById('policy-save-status');
  const policySaveError = document.getElementById('policy-save-error');
  /** select 표시값을 저장 상태에 맞춤 — 저장된 정책이 없으면 반드시 '' (브라우저 복원·자동 선택 방지) */
  const syncPolicySelect = () => {
    const want = policySelection.selectValue;
    policySelect.value = want;
    if (policySelect.value !== want) policySelect.value = '';
  };
  syncPolicySelect();
  window.addEventListener('pageshow', syncPolicySelect);
  window.addEventListener('load', syncPolicySelect);
  const policyStatus = document.getElementById('policy-status');
  const policyError = document.getElementById('policy-error');
  let policies = [];

  const renderPolicySummary = () => {
    const box = document.getElementById('policy-summary');
    box.replaceChildren();
    if (!currentPolicy) {
      const span = document.createElement('span');
      span.className = 'import-policy-missing';
      span.textContent = '배송정책을 선택해주세요. 상품 검수와 배송비 계산은 가능하지만 eBay 등록은 할 수 없습니다.';
      box.appendChild(span);
      return;
    }
    const name = document.createElement('strong');
    name.textContent = currentPolicy.policyName;
    const fee = document.createElement('strong');
    fee.textContent = formatBuyerShipping(currentPolicy.buyerShippingUsd);
    box.append('선택 배송정책: ', name, ' · 구매자 배송비: ', fee);
  };

  /** 정책 변경 시 전체 행의 정책 배송비·구매자 총 결제를 브라우저에서 즉시 갱신 (견적 재요청 없음) */
  const renderPolicyTotals = () => {
    const fee = currentPolicy ? formatBuyerShipping(currentPolicy.buyerShippingUsd) : '';
    document.querySelectorAll('tr.import-row').forEach(tr => {
      const cell = tr.querySelector('.cell-policy-shipping');
      if (!cell || !tr.querySelector('.row-provider')) return;
      cell.textContent = fee || '정책 미선택';
      const total = buyerTotalLabel(tr.dataset.listingUsd, currentPolicy);
      tr.querySelector('.cell-buyer-total').textContent = total ? '구매자 총 결제 ' + total : '';
    });
  };

  const policySearch = document.getElementById('policy-search');
  /** 검색어로 걸러 무료배송(추천) → 유료배송 → 선택 불가 그룹으로 표시. 무료배송도 자동 선택하지 않음 */
  const renderPolicyOptions = () => {
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = POLICY_PLACEHOLDER_LABEL;
    const options = [placeholder];
    let found = false;
    const wantValue = policySelection.selectValue;
    const groups = groupShippingPolicies(policies, policySearch.value, wantValue || null);
    groups.forEach(group => {
      if (group.policies.length === 0) return;
      const optgroup = document.createElement('optgroup');
      optgroup.label = group.label + ' (' + group.policies.length + ')';
      group.policies.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p.policyId;
        opt.textContent = policyOptionLabel(p);
        opt.disabled = !p.supported;
        if (wantValue && p.policyId === wantValue) { opt.selected = true; found = true; }
        optgroup.appendChild(opt);
      });
      options.push(optgroup);
    });
    const matched = groups.reduce((n, g) => n + g.policies.length, 0);
    if (policySearch.value.trim() && matched === 0) {
      const none = document.createElement('option');
      none.disabled = true;
      none.textContent = '검색 결과 없음';
      options.push(none);
    }
    if (currentPolicy && wantValue === currentPolicy.policyId && !found) {
      const missing = document.createElement('option');
      missing.value = currentPolicy.policyId;
      missing.textContent = currentPolicy.policyName + ' — eBay 목록에 없음 (등록 차단)';
      missing.selected = true;
      options.push(missing);
    }
    //   저장된(또는 저장 중인) 정책이 없으면 placeholder('')만 선택 — 첫 실제 정책 자동 선택 방지
    placeholder.selected = !wantValue;
    policySelect.replaceChildren(...options);
    syncPolicySelect();
  };
  policySearch.addEventListener('input', () => renderPolicyOptions());

  async function loadPolicies(refresh) {
    policyError.hidden = true;
    policyStatus.textContent = '배송정책 목록 불러오는 중…';
    try {
      const res = await fetch('/api/ebay/shipping-policies' + (refresh ? '?refresh=1' : ''));
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'HTTP ' + res.status);
      policies = data.policies;
      renderPolicyOptions();
      const supported = policies.filter(p => p.supported).length;
      policyStatus.textContent = `선택 가능 ${supported} / 전체 ${policies.length}개` + (data.stale ? ' · 최근 조회 실패로 마지막 목록 표시' : '');
    } catch (e) {
      policyStatus.textContent = '';
      policyError.hidden = false;
    }
  }

  const showPolicySaveError = (result) => {
    document.getElementById('policy-save-error-message').textContent = result.message;
    document.getElementById('policy-save-error-detail').textContent = '(HTTP ' + (result.httpStatus ?? '-') + (result.code ? ' · ' + result.code : '') + ')';
    policySaveError.hidden = false;
  };

  policySelect.addEventListener('change', () => {
    const policyId = policySelect.value;
    if (policySelection.saving) { syncPolicySelect(); return; }   // 저장 중 중복 선택 방지
    if (!policyId || (currentPolicy && policyId === currentPolicy.policyId)) { syncPolicySelect(); return; }
    if ((currentPolicy || hasImportedRows) && !window.confirm('아직 eBay에 등록되지 않은 이 CSV 상품에도 새 정책을 적용합니다.')) {
      syncPolicySelect();
      return;
    }
    const started = quoteRun.run(async () => {
      setBusy(true);
      policySaveError.hidden = true;
      policySaveStatus.textContent = POLICY_SAVING_LABEL;
      policySaveStatus.hidden = false;
      const pending = policySelection.select(policyId);
      syncPolicySelect();
      refreshImportButton();
      const result = await pending;
      if (result.status === 'saved') {
        currentPolicy = result.policy;
        renderPolicySummary();
        renderPolicyTotals();
        const a = result.applied || {};
        policySaveStatus.textContent = '저장됨 · 가져온 미등록 상품 반영 ' + (a.crawlRowsUpdated || 0) + '개'
          + (a.skippedRegistered ? ' · 등록된 상품 보호 ' + a.skippedRegistered + '개' : '')
          + (a.skippedManual ? ' · 수동 정책 유지 ' + a.skippedManual + '개' : '');
        toast('배송정책 저장: ' + currentPolicy.policyName + ' · 구매자 배송비 ' + formatBuyerShipping(currentPolicy.buyerShippingUsd), 'success');
      } else {
        policySaveStatus.hidden = true;
        if (result.status === 'error') {
          showPolicySaveError(result);
          toast('배송정책 저장 실패: ' + result.message, 'error');
        }
      }
      renderPolicyOptions();
      setBusy(false);
    });
    if (started === null) {
      syncPolicySelect();
      toast('다른 작업이 진행 중이라 배송정책을 저장하지 않았습니다. 잠시 후 다시 선택하세요.', 'error');
    }
  });
  document.getElementById('policy-reload-btn').addEventListener('click', () => loadPolicies(true));
  loadPolicies(false);

  const filterRows = (onlyReview) => {
    document.querySelectorAll('tr.import-row').forEach(tr => { tr.hidden = onlyReview && tr.dataset.quoteCategory !== 'REVIEW'; });
  };
  document.getElementById('filter-review-btn').addEventListener('click', () => filterRows(true));
  document.getElementById('filter-all-btn').addEventListener('click', () => filterRows(false));
}

importBtn.addEventListener('click', importData);
render();

async function importData() {
  if (selection.count() === 0) return;
  importBtn.disabled = true;
  importBtn.innerHTML = '<span class="spinner"></span> 등록 중...';

  try {
    // 3분 타임아웃 (대용량 CSV 대응)
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 180000);

    const res = await fetch('/api/import/batch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(buildImportPayload(uploadId, selection, showShipping ? providers : undefined)),
      signal: controller.signal,
    });
    clearTimeout(timeout);

    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error || '서버 오류 (HTTP ' + res.status + ')');
    }

    document.getElementById('result-content').innerHTML =
      '<div class="summary">' +
      '<div class="summary-item summary-success"><div class="number">' + (data.imported || 0) + '</div><div class="label">신규 등록</div></div>' +
      '<div class="summary-item summary-total"><div class="number">' + (data.updated || 0) + '</div><div class="label">업데이트</div></div>' +
      '<div class="summary-item summary-fail"><div class="number">' + (data.errors || 0) + '</div><div class="label">오류</div></div>' +
      '</div>';

    document.getElementById('import-result').classList.remove('hidden');
    hasImportedRows = true;
    importBtn.innerHTML = '<i class="ti ti-circle-check"></i> 등록 완료';
    checkboxes.forEach(cb => { cb.disabled = true; });
    providerSelects.forEach(sel => { sel.disabled = true; });

    if (typeof showToast === 'function') showToast((data.imported || 0) + '개 상품이 등록되었습니다.', 'success');
  } catch (e) {
    const msg = e.name === 'AbortError' ? '시간 초과 — CSV 파일이 너무 크거나 서버에 문제가 있습니다.' : e.message;
    importBtn.disabled = false;
    importBtn.innerHTML = '<i class="ti ti-database-plus"></i> 다시 시도 (<span id="import-count">' + selection.count() + '</span>개)';
    if (typeof showToast === 'function') showToast('등록 실패: ' + msg, 'error');
  }
}
</script>
