<%
  const shipping = it.shipping || { enabled: false, buyerShippingUsd: null, exchangeRateConfigured: false, quoteConfigured: false };
  const showShipping = !!it.showShipping;
  const buyerShippingLabel = shipping.buyerShippingUsd ? '$' + Number(shipping.buyerShippingUsd).toFixed(2) : '—';
  const quoteSummary = { ok: 0, recovered: 0, alternative: 0, review: 0 };
  it.rows.forEach(r => {
    if (!r.shippingProvider) return;
    if (r.quoteCategory === 'OK') quoteSummary.ok++;
    else if (r.quoteCategory === 'RECOVERED') quoteSummary.recovered++;
    else if (r.quoteCategory === 'ALTERNATIVE') quoteSummary.alternative++;
    else if (r.quoteCategory === 'REVIEW') quoteSummary.review++;
  });
  const quotedCount = quoteSummary.ok + quoteSummary.recovered + quoteSummary.alternative + quoteSummary.review;
  const fmt = (v) => Number(v).toLocaleString('en-US');
%>
<div class="page-header">
  <h1 class="page-title">상품 검수 · 선택</h1>
  <span class="badge badge-unregistered"><i class="ti ti-database-off"></i> 미등록</span>
</div>

<div class="card">
  <div class="section-header import-toolbar">
    <h2><i class="ti ti-table"></i> 발견된 상품</h2>
    <div class="import-toolbar-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="select-all-btn"><i class="ti ti-checks"></i> 전체 선택</button>
      <button type="button" class="btn btn-secondary btn-sm" id="clear-all-btn"><i class="ti ti-square-off"></i> 전체 해제</button>
      <span class="text-muted" id="selection-summary" data-testid="selection-count">선택 <%= it.defaultSelectedCount %> / 전체 <%= it.rowCount %>개</span>
    </div>
  </div>

  <% if (showShipping) { %>
  <div class="import-shipping-bar" id="shipping-bar">
    <label class="import-shipping-label" for="bulk-provider">선택 상품 배송사</label>
    <select id="bulk-provider" class="import-select">
      <option value="KPL" selected>KPL</option>
      <option value="eGS">eGS</option>
    </select>
    <button type="button" class="btn btn-secondary btn-sm" id="bulk-provider-btn"><i class="ti ti-truck"></i> 적용</button>
    <button type="button" class="btn btn-primary btn-sm" id="quote-btn"<%~ shipping.quoteConfigured ? '' : ' disabled' %>><i class="ti ti-calculator"></i> 선택 상품 국제배송비 계산</button>
    <span class="text-muted import-shipping-meta">eBay US 기준 · KPL은 미국 서비스만 사용 · 배송정책 <strong><%= buyerShippingLabel %></strong>은 구매자 별도 청구 (등록가에서 빼거나 더하지 않음)</span>
    <span class="import-egs-warning" id="egs-warning"><i class="ti ti-alert-triangle"></i> eGS는 브랜드 상품에 사용하지 않습니다.</span>
  </div>
  <% if (!shipping.enabled) { %>
  <div class="import-notice import-notice-info" data-testid="release-guard-notice">
    <i class="ti ti-lock"></i> <strong>배송비 계산 준비 중</strong> — 현재는 상품 검수와 가져오기만 가능합니다. 배송비 반영 전에는 eBay 등록이 차단됩니다. 아래 배송비·등록가는 미리보기입니다.
  </div>
  <% } %>
  <div class="import-quote-progress" id="quote-progress" data-testid="quote-progress" hidden>
    <span class="spinner"></span> <strong id="quote-progress-main">배송비 계산 중 0 / 0</strong>
    <span class="text-muted" id="quote-progress-detail">정상 0 · 재시도 0 · 실패 0</span>
  </div>
  <div class="import-quote-summary" id="quote-summary" data-testid="quote-summary"<%~ quotedCount > 0 ? '' : ' hidden' %>>
    <span class="import-quote-summary-text" id="quote-summary-text">정상 <%= fmt(quoteSummary.ok) %>개 · 자동복구 <%= fmt(quoteSummary.recovered) %>개 · 대체 가능 <%= fmt(quoteSummary.alternative) %>개 · 확인 필요 <%= fmt(quoteSummary.review) %>개</span>
    <button type="button" class="btn btn-secondary btn-xs" id="retry-failed-btn"><i class="ti ti-refresh"></i> 실패 항목 자동 재계산</button>
    <button type="button" class="btn btn-secondary btn-xs" id="apply-all-alt-btn"><i class="ti ti-arrows-exchange"></i> 대체 가능 전체 적용</button>
    <button type="button" class="btn btn-secondary btn-xs" id="filter-review-btn"><i class="ti ti-filter"></i> 확인 필요만 보기</button>
    <button type="button" class="btn btn-secondary btn-xs" id="filter-all-btn"><i class="ti ti-list"></i> 전체 보기</button>
  </div>
  <% if (!shipping.quoteConfigured || !shipping.exchangeRateConfigured) { %>
  <div class="import-notice import-notice-error">
    <i class="ti ti-alert-circle"></i> 배송 견적 설정이 없습니다 (<%= !shipping.quoteConfigured ? 'main service 연결' : '' %><%= !shipping.quoteConfigured && !shipping.exchangeRateConfigured ? ', ' : '' %><%= !shipping.exchangeRateConfigured ? '배송비 환율' : '' %>). 견적이 차단되며 배송비 반영 등록도 차단됩니다.
  </div>
  <% } %>
  <% } %>

  <% if (it.errorRowCount > 0) { %>
  <div class="import-notice import-notice-error">
    <i class="ti ti-alert-circle"></i> 데이터 오류 <strong><%= it.errorRowCount %></strong>개 행은 기본 선택에서 제외되었습니다. 확인 후 필요하면 직접 선택하세요.
  </div>
  <% } %>

  <div style="overflow-x: auto;">
    <table id="import-table">
      <thead>
        <tr>
          <th style="width:36px">선택</th>
          <th>이미지</th>
          <th>상품코드</th>
          <th>상품명</th>
          <th class="text-right"><%= showShipping ? 'CSV 판매가(USD)' : it.priceHeader %></th>
          <th class="text-right">적용무게</th>
          <% if (showShipping) { %>
          <th>배송사</th>
          <th class="text-right">예상 국제배송비</th>
          <th class="text-right">eBay 등록 상품가격</th>
          <th class="text-right">배송정책 별도 청구</th>
          <% } %>
          <th>원본 링크</th>
          <th>상태</th>
        </tr>
      </thead>
      <tbody>
        <% it.rows.forEach((row) => { %>
        <tr class="import-row<%= row.errorCount > 0 ? ' import-row-error' : '' %>" data-index="<%= row.index %>" data-quote-category="<%= row.quoteCategory %>">
          <td>
            <input type="checkbox" class="import-row-check" data-index="<%= row.index %>" aria-label="상품 선택 <%= row.index + 1 %>"<%~ row.defaultSelected ? ' checked' : '' %>>
          </td>
          <td>
            <% if (row.image) { %>
              <img src="<%= row.image %>" class="thumb import-thumb" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="thumb thumb-placeholder" style="display:none"><i class="ti ti-photo-off"></i></div>
            <% } else { %>
              <div class="thumb thumb-placeholder" style="display:flex"><i class="ti ti-photo-off"></i></div>
            <% } %>
          </td>
          <td class="tabular-nums nowrap"><%= row.code || '—' %></td>
          <td class="import-name"><span class="truncate" title="<%= row.name %>"><%= row.name %></span></td>
          <td class="text-right tabular-nums nowrap"><%= row.priceLabel %></td>
          <td class="text-right tabular-nums nowrap"><%= row.weightLabel %></td>
          <% if (showShipping) { %>
          <td class="nowrap">
            <% if (row.shippingProvider) { %>
            <select class="import-select row-provider" data-index="<%= row.index %>" aria-label="배송사 <%= row.index + 1 %>">
              <option value="KPL"<%~ row.shippingProvider === 'KPL' ? ' selected' : '' %>>KPL</option>
              <option value="eGS"<%~ row.shippingProvider === 'eGS' ? ' selected' : '' %>>eGS</option>
            </select>
            <% } else { %>—<% } %>
          </td>
          <td class="text-right tabular-nums nowrap cell-shipping" data-quote-status="<%= row.quoteStatus %>" title="<%= row.quoteTitle %>"><%= row.shippingLabel %></td>
          <td class="text-right tabular-nums nowrap cell-listing"><strong><%= row.listingPriceLabel %></strong></td>
          <td class="text-right tabular-nums nowrap text-muted"><%= row.shippingProvider ? buyerShippingLabel : '—' %><div class="import-quote-msg cell-buyer-total"><%= row.buyerTotalLabel ? '구매자 총 ' + row.buyerTotalLabel : '' %></div></td>
          <% } %>
          <td class="nowrap">
            <% if (row.url) { %>
              <a href="<%= row.url %>" target="_blank" rel="noopener"><i class="ti ti-external-link"></i> 링크</a>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td class="nowrap">
            <% if (row.errorCount > 0) { %>
              <span class="badge badge-error" title="<%= row.issues.map(i => i.message).join(', ') %>"><i class="ti ti-alert-circle"></i> 오류 <%= row.errorCount %></span>
            <% } else if (row.warningCount > 0) { %>
              <span class="badge badge-pending" title="<%= row.issues.map(i => i.message).join(', ') %>"><i class="ti ti-alert-triangle"></i> 경고 <%= row.warningCount %></span>
            <% } else { %>
              <span class="badge badge-success"><i class="ti ti-check"></i> 정상</span>
            <% } %>
            <% if (showShipping) { %>
              <div class="import-quote-msg cell-quote-msg<%= row.quoteStatus === 'BLOCKED' || row.quoteStatus === 'WEIGHT_INVALID' ? ' is-blocked' : '' %>" title="<%= row.quoteTitle %>" data-testid="quote-detail">
                <% if (row.weightRecoveryLabel) { %><div class="quote-line quote-recovery"><%= row.weightRecoveryLabel %></div><% } %>
                <% if (row.reasonLabel) { %>
                <div class="quote-line">원인: <%= row.reasonLabel %></div>
                <% } else if (row.quoteMessage) { %>
                <div class="quote-line"><%= row.quoteMessage %></div>
                <% } %>
                <% if (row.retryNote) { %><div class="quote-line">처리: <%= row.retryNote %></div><% } %>
                <% if (row.alternative) { %>
                <div class="quote-line quote-alt">대체: <%= row.alternative.label %> · 등록가 <%= row.alternative.listingPriceLabel %>
                  <button type="button" class="btn btn-secondary btn-xs apply-alt-btn" data-index="<%= row.index %>">대체 적용</button>
                  <% if (row.alternative.warning) { %><div class="quote-alt-warn"><%= row.alternative.warning %></div><% } %>
                </div>
                <% } %>
                <% if (row.alternativeFailureLabel) { %><div class="quote-line">대체: <%= row.alternativeFailureLabel %></div><% } %>
              </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (showShipping && !shipping.enabled) { %>
  <div class="import-notice import-notice-info mt-24 import-release-guard">
    <i class="ti ti-lock"></i> <strong>배송비 계산 준비 중</strong><br>현재는 상품 검수와 가져오기만 가능합니다.<br>배송비 반영 전에는 eBay 등록이 차단됩니다.
  </div>
  <% } %>
  <div class="flex justify-between align-center mt-24">
    <a href="/upload-csv" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> 뒤로</a>
    <button id="import-btn" class="btn btn-primary btn-lg"<%~ it.defaultSelectedCount === 0 ? ' disabled' : '' %>>
      <i class="ti ti-database-plus"></i> 선택 상품 DB에 등록하기 (<span id="import-count"><%= it.defaultSelectedCount %></span>개)
    </button>
  </div>
</div>

<div id="import-result" class="card hidden">
  <div class="section-header">
    <h2><i class="ti ti-circle-check" style="color: var(--green);"></i> 등록 완료</h2>
  </div>
  <div id="result-content"></div>
  <div class="mt-16">
    <a id="next-link" href="/" class="btn btn-success btn-lg">
      <i class="ti ti-arrow-right"></i> 다음: 상품 관리
    </a>
  </div>
</div>

<style>
.import-toolbar { flex-wrap: wrap; gap: 8px; }
.import-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.import-notice { padding: 10px 16px; border-radius: var(--radius); font-size: var(--text-sm); margin-bottom: 12px; }
.import-notice-error { color: var(--red); background: rgba(220,38,38,0.08); }
.import-notice-info { color: var(--text); background: rgba(37,99,235,0.07); }
.import-name { max-width: 360px; }
.import-row-error { background: rgba(220,38,38,0.04); }
.thumb-placeholder { align-items: center; justify-content: center; }
.thumb-placeholder i { font-size: 14px; color: var(--text-muted); }
.import-shipping-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius); }
.import-shipping-label { font-size: var(--text-sm); font-weight: 600; }
.import-select { padding: 4px 8px; border-radius: var(--radius); border: 1px solid var(--border); font-size: var(--text-sm); }
.import-shipping-meta { font-size: var(--text-xs); }
.import-egs-warning { font-size: var(--text-xs); color: var(--yellow-text, #a16207); }
.import-quote-msg { font-size: var(--text-xs); color: var(--text-muted); margin-top: 2px; max-width: 220px; white-space: normal; }
.import-quote-msg.is-blocked { color: var(--red); }
.import-quote-msg .quote-line { line-height: 1.35; }
.import-quote-msg .quote-recovery { color: var(--yellow-text, #a16207); }
.import-quote-msg .quote-alt { color: var(--text); }
.import-quote-msg .quote-alt-warn { color: var(--yellow-text, #a16207); }
.import-quote-msg .apply-alt-btn { margin-left: 4px; padding: 0 6px; }
.import-quote-summary, .import-quote-progress { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; margin-bottom: 12px; border: 1px solid var(--border); border-radius: var(--radius); font-size: var(--text-sm); }
.import-quote-summary-text { font-weight: 600; }
</style>

<script type="module">
import { createSelection, createProviderState, buildImportPayload, buildQuoteRequest, formatSelectionSummary, formatQuoteSummary, formatQuoteProgress, createSingleFlight, failedQuoteSelections } from '/js/import-selection.js';

const uploadId = <%~ JSON.stringify(it.uploadId).replace(/</g, '\\u003c') %>;
const showShipping = <%~ showShipping ? 'true' : 'false' %>;
const checkboxes = Array.from(document.querySelectorAll('.import-row-check'));
const indexOf = (el) => Number(el.dataset.index);
const selection = createSelection(
  checkboxes.map(indexOf),
  checkboxes.filter(cb => cb.checked).map(indexOf),
);
const providerSelects = Array.from(document.querySelectorAll('.row-provider'));
const providers = createProviderState(providerSelects.map(sel => ({ index: indexOf(sel), provider: sel.value })));
const rowOf = (index) => document.querySelector('tr.import-row[data-index="' + index + '"]');

const importBtn = document.getElementById('import-btn');

function render() {
  checkboxes.forEach(cb => { cb.checked = selection.isSelected(indexOf(cb)); });
  document.getElementById('selection-summary').textContent = formatSelectionSummary(selection);
  document.getElementById('import-count').textContent = selection.count().toLocaleString('en-US');
  importBtn.disabled = selection.count() === 0;
}

function markStale(index) {
  const tr = rowOf(index);
  if (!tr) return;
  const shippingCell = tr.querySelector('.cell-shipping');
  if (shippingCell && shippingCell.dataset.quoteStatus !== 'WEIGHT_INVALID') {
    shippingCell.textContent = '미계산';
    shippingCell.dataset.quoteStatus = 'NONE';
    shippingCell.title = '';
    tr.dataset.quoteCategory = 'NONE';
    tr.querySelector('.cell-listing').innerHTML = '<strong>—</strong>';
    tr.querySelector('.cell-buyer-total').textContent = '';
    const msg = tr.querySelector('.cell-quote-msg');
    msg.replaceChildren(line('배송사 변경 — 배송비 다시 계산 필요'));
    msg.title = '';
    msg.classList.remove('is-blocked');
  }
}

function line(text, className) {
  const div = document.createElement('div');
  div.className = 'quote-line' + (className ? ' ' + className : '');
  div.textContent = text;
  return div;
}

function applyQuoteRow(r) {
  const tr = rowOf(r.index);
  if (!tr) return;
  tr.dataset.quoteCategory = r.quoteCategory;
  const shippingCell = tr.querySelector('.cell-shipping');
  shippingCell.textContent = r.shippingLabel;
  shippingCell.dataset.quoteStatus = r.quoteStatus;
  shippingCell.title = r.quoteTitle || '';
  const listing = document.createElement('strong');
  listing.textContent = r.listingPriceLabel;
  tr.querySelector('.cell-listing').replaceChildren(listing);
  tr.querySelector('.cell-buyer-total').textContent = r.buyerTotalLabel ? '구매자 총 ' + r.buyerTotalLabel : '';

  const msg = tr.querySelector('.cell-quote-msg');
  const lines = [];
  if (r.weightRecoveryLabel) lines.push(line(r.weightRecoveryLabel, 'quote-recovery'));
  if (r.reasonLabel) lines.push(line('원인: ' + r.reasonLabel));
  else if (r.quoteMessage) lines.push(line(r.quoteMessage));
  if (r.retryNote) lines.push(line('처리: ' + r.retryNote));
  if (r.alternative) {
    const alt = line('대체: ' + r.alternative.label + ' · 등록가 ' + r.alternative.listingPriceLabel + ' ', 'quote-alt');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-secondary btn-xs apply-alt-btn';
    btn.dataset.index = String(r.index);
    btn.textContent = '대체 적용';
    btn.disabled = quoteRun.isRunning();
    alt.appendChild(btn);
    if (r.alternative.warning) {
      const warn = document.createElement('div');
      warn.className = 'quote-alt-warn';
      warn.textContent = r.alternative.warning;
      alt.appendChild(warn);
    }
    lines.push(alt);
  }
  if (r.alternativeFailureLabel) lines.push(line('대체: ' + r.alternativeFailureLabel));
  msg.replaceChildren(...lines);
  msg.title = r.quoteTitle || '';
  msg.classList.toggle('is-blocked', r.quoteStatus === 'BLOCKED' || r.quoteStatus === 'WEIGHT_INVALID');

  if (r.shippingProvider && providers.get(r.index) !== r.shippingProvider) {
    providers.set(r.index, r.shippingProvider);
    const sel = tr.querySelector('.row-provider');
    if (sel) sel.value = r.shippingProvider;
  }
}

const quoteRun = createSingleFlight();

document.getElementById('import-table').addEventListener('change', (e) => {
  const cb = e.target.closest('.import-row-check');
  if (cb) {
    selection.set(indexOf(cb), cb.checked);
    render();
    return;
  }
  const sel = e.target.closest('.row-provider');
  if (sel && providers.set(indexOf(sel), sel.value)) markStale(indexOf(sel));
});
document.getElementById('select-all-btn').addEventListener('click', () => { selection.selectAll(); render(); });
document.getElementById('clear-all-btn').addEventListener('click', () => { selection.clearAll(); render(); });

if (showShipping) {
  document.getElementById('bulk-provider-btn').addEventListener('click', () => {
    const provider = document.getElementById('bulk-provider').value;
    providers.setMany(selection.selectedIndices(), provider).forEach(index => {
      const sel = rowOf(index)?.querySelector('.row-provider');
      if (sel) sel.value = provider;
      markStale(index);
    });
  });

  const quoteBtn = document.getElementById('quote-btn');
  const summaryBox = document.getElementById('quote-summary');
  const progressBox = document.getElementById('quote-progress');
  const busyButtons = () => [quoteBtn, importBtn, document.getElementById('bulk-provider-btn'), document.getElementById('retry-failed-btn'), document.getElementById('apply-all-alt-btn'), ...document.querySelectorAll('.apply-alt-btn')];
  const setBusy = (busy) => {
    busyButtons().forEach(b => { if (b) b.disabled = busy; });
    if (!busy) { importBtn.disabled = selection.count() === 0; quoteBtn.disabled = <%~ shipping.quoteConfigured ? 'false' : 'true' %>; }
  };
  const toast = (m, type) => { if (typeof showToast === 'function') showToast(m, type); };
  const updateSummary = (summary) => {
    if (!summary) return;
    document.getElementById('quote-summary-text').textContent = formatQuoteSummary(summary);
    summaryBox.hidden = (summary.ok + summary.recovered + summary.alternative + summary.review) === 0;
  };
  const showProgress = (p) => {
    const text = formatQuoteProgress(p);
    document.getElementById('quote-progress-main').textContent = text.main;
    document.getElementById('quote-progress-detail').textContent = text.detail;
  };
  const sleep = (ms) => new Promise(r => setTimeout(r, ms));

  async function runQuote(selections) {
    if (selections.length === 0) { toast('배송비를 계산할 상품을 선택하세요.', 'error'); return; }
    const started = quoteRun.run(async () => {
      setBusy(true);
      progressBox.hidden = false;
      showProgress({ total: 0, done: 0, ok: 0, retried: 0, failed: 0 });
      try {
        const res = await fetch('/api/upload/shipping-quotes/jobs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uploadId, selections }),
        });
        const start = await res.json();
        if (!res.ok) throw new Error(start.error || '서버 오류 (HTTP ' + res.status + ')');
        let job = start;
        while (job.status === 'running') {
          showProgress(job.progress);
          await sleep(700);
          const poll = await fetch('/api/upload/shipping-quotes/jobs/' + encodeURIComponent(start.jobId));
          job = await poll.json();
          if (!poll.ok) throw new Error(job.error || '서버 오류 (HTTP ' + poll.status + ')');
        }
        if (job.status === 'error' || !job.result) throw new Error(job.error || '배송비 계산 실패');
        showProgress(job.progress);
        job.result.rows.forEach(applyQuoteRow);
        updateSummary(job.result.summary);
        const s = job.result.summary;
        toast('배송비 계산 완료: ' + formatQuoteSummary(s), s.review === 0 ? 'success' : 'error');
      } catch (e) {
        toast('배송비 계산 실패: ' + e.message, 'error');
      } finally {
        progressBox.hidden = true;
        setBusy(false);
      }
    });
    if (started === null) toast('배송비 계산이 이미 진행 중입니다.', 'error');
  }

  async function applyAlternatives(payload) {
    const started = quoteRun.run(async () => {
      setBusy(true);
      try {
        const res = await fetch('/api/upload/shipping-alternatives/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uploadId, ...payload }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '서버 오류 (HTTP ' + res.status + ')');
        data.rows.forEach(applyQuoteRow);
        updateSummary(data.summary);
        toast('대체 배송사 적용: ' + data.applied.length + '개' + (data.skipped.length ? ' (제외 ' + data.skipped.length + '개)' : ''), data.applied.length ? 'success' : 'error');
      } catch (e) {
        toast('대체 적용 실패: ' + e.message, 'error');
      } finally {
        setBusy(false);
      }
    });
    if (started === null) toast('다른 작업이 진행 중입니다.', 'error');
  }

  quoteBtn.addEventListener('click', () => runQuote(buildQuoteRequest(uploadId, selection, providers).selections));
  document.getElementById('retry-failed-btn').addEventListener('click', () => {
    const states = Array.from(document.querySelectorAll('tr.import-row')).map(tr => ({ index: indexOf(tr), quoteCategory: tr.dataset.quoteCategory }));
    runQuote(failedQuoteSelections(states, providers));
  });
  document.getElementById('apply-all-alt-btn').addEventListener('click', () => applyAlternatives({ all: true }));
  document.getElementById('import-table').addEventListener('click', (e) => {
    const btn = e.target.closest('.apply-alt-btn');
    if (btn) applyAlternatives({ indices: [Number(btn.dataset.index)] });
  });
  const filterRows = (onlyReview) => {
    document.querySelectorAll('tr.import-row').forEach(tr => { tr.hidden = onlyReview && tr.dataset.quoteCategory !== 'REVIEW'; });
  };
  document.getElementById('filter-review-btn').addEventListener('click', () => filterRows(true));
  document.getElementById('filter-all-btn').addEventListener('click', () => filterRows(false));
}

importBtn.addEventListener('click', importData);
render();

async function importData() {
  if (selection.count() === 0) return;
  importBtn.disabled = true;
  importBtn.innerHTML = '<span class="spinner"></span> 등록 중...';

  try {
    // 3분 타임아웃 (대용량 CSV 대응)
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 180000);

    const res = await fetch('/api/import/batch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(buildImportPayload(uploadId, selection, showShipping ? providers : undefined)),
      signal: controller.signal,
    });
    clearTimeout(timeout);

    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error || '서버 오류 (HTTP ' + res.status + ')');
    }

    document.getElementById('result-content').innerHTML =
      '<div class="summary">' +
      '<div class="summary-item summary-success"><div class="number">' + (data.imported || 0) + '</div><div class="label">신규 등록</div></div>' +
      '<div class="summary-item summary-total"><div class="number">' + (data.updated || 0) + '</div><div class="label">업데이트</div></div>' +
      '<div class="summary-item summary-fail"><div class="number">' + (data.errors || 0) + '</div><div class="label">오류</div></div>' +
      '</div>';

    document.getElementById('import-result').classList.remove('hidden');
    importBtn.innerHTML = '<i class="ti ti-circle-check"></i> 등록 완료';
    checkboxes.forEach(cb => { cb.disabled = true; });
    providerSelects.forEach(sel => { sel.disabled = true; });

    if (typeof showToast === 'function') showToast((data.imported || 0) + '개 상품이 등록되었습니다.', 'success');
  } catch (e) {
    const msg = e.name === 'AbortError' ? '시간 초과 — CSV 파일이 너무 크거나 서버에 문제가 있습니다.' : e.message;
    importBtn.disabled = false;
    importBtn.innerHTML = '<i class="ti ti-database-plus"></i> 다시 시도 (<span id="import-count">' + selection.count() + '</span>개)';
    if (typeof showToast === 'function') showToast('등록 실패: ' + msg, 'error');
  }
}
</script>
