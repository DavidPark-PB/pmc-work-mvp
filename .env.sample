# Shopify API Credentials
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_STORE=your-store
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01
SHOPIFY_LOCATION_ID=

# eBay API Credentials (Production)
EBAY_APP_ID=your-ebay-app-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_USER_TOKEN=your-ebay-user-token
EBAY_REFRESH_TOKEN=your-ebay-refresh-token
EBAY_RUNAME=your-ebay-runame
EBAY_ENVIRONMENT=PRODUCTION

# Google Sheets
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id

# ── 카탈로그 가격 (Google Sheets 3시트: USD/KRW/EURO) ──
# 로컬 개발: config/service-account.json 파일 사용 (keyFile 방식, .gitignore 됨)
# Railway/Heroku 등 파일 시스템 없는 호스팅: 아래 env 로 JSON 전체 문자열 주입.
# 값은 서비스 계정 JSON 그대로 (한 줄로, 이스케이프 필요 시 \" 사용).
# 미설정 시 catalog 페이지에서 "GOOGLE_CREDENTIALS_JSON 환경변수 확인 필요" 힌트 노출.
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
# 시트 ID (기본값은 catalogService.js 안 하드코딩 — 다른 시트 쓸 때만 override)
# SHEET_ID_USD=
# SHEET_ID_KRW=
# SHEET_ID_EURO=

# ── Alibaba (ICBU) ────────────────────────────
ALIBABA_APP_KEY=your-alibaba-app-key
ALIBABA_APP_SECRET=your-alibaba-app-secret
ALIBABA_ACCESS_TOKEN=your-alibaba-access-token
ALIBABA_REFRESH_TOKEN=your-alibaba-refresh-token
ALIBABA_PLATFORM=international

# ── Shopee ─────────────────────────────────────
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key
SHOPEE_SHOP_ID=your-shopee-shop-id
SHOPEE_MERCHANT_ID=your-shopee-merchant-id
SHOPEE_ACCESS_TOKEN=your-shopee-access-token
SHOPEE_REFRESH_TOKEN=your-shopee-refresh-token
SHOPEE_ENV=test

# ── Qoo10 Japan (추후 입력) ──────────────────
# QOO10_API_KEY=
# QOO10_USER_ID=
# QOO10_USER_PASSWORD=

# ── 쿠팡 (추후 입력) ─────────────────────────
# COUPANG_ACCESS_KEY=
# COUPANG_SECRET_KEY=
# COUPANG_VENDOR_ID=

# ── 네이버 스마트스토어 ──────────────────────
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── AI (Google Gemini) — 모든 AI 서비스 공용 ─────
# 2026-08-08: 모든 서비스 Anthropic → Gemini 전환 완료.
# 미설정 시 각 서비스가 mock 응답 반환 (silent degrade).
#   사용 서비스: CS 4개 (분석/답변/톤/번역), aiRemarker, aiDraftGenerator,
#              b2bInvoiceParser (Vision), aiMatcher, translationService, marketAgent
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# 모델 fallback 리스트 (콤마 구분). 첫 모델이 429/404 나면 다음 모델 자동 시도.
# CS_GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-flash-lite,gemini-flash-latest

# 개별 서비스 override (fallback 리스트의 맨 앞에 삽입됨)
# CS_ANALYZER_DEFAULT_MODEL=
# CS_REPLY_DEFAULT_MODEL=
# CS_TONE_DEFAULT_MODEL=
# CS_TRANSLATE_DEFAULT_MODEL=
# AI_DRAFT_DEFAULT_MODEL=
# AIMATCHER_DEFAULT_MODEL=
# MARKET_AGENT_MODEL=

# 테스트/개발용 강제 mock (실제 API 호출 안 함)
# CS_ANALYZER_MOCK_MODE=true
# CS_REPLY_MOCK_MODE=true
# CS_TONE_MOCK_MODE=true
# CS_TRANSLATE_MOCK_MODE=true
# AI_DRAFT_MOCK_MODE=true
